# LLM (optional — without a key the agent uses extractive, cited answers)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Groq example: LLM_BASE_URL=https://api.groq.com/openai/v1
# Ollama example (no key needed): LLM_BASE_URL=http://localhost:11434/v1

# Optional search backends (default is zero-key DuckDuckGo)
TAVILY_API_KEY=
SERPER_API_KEY=

# Storage / cache
ONE_TOOL_DB=memory.db
SEARCH_CACHE_TTL=900
